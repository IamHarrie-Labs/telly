{
  "name": "telly",
  "version": "0.1.0",
  "private": true,
  "description": "Telly: tell it once, keep it current. Turn an event flyer into an accessible Buffer campaign that stays correct when plans change.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "certs": "node scripts/generate-cert.js",
    "test": "node --test",
    "e2e": "node e2e/run.mjs",
    "migrate": "node scripts/migrate.js",
    "check": "npm test && npm run e2e && npm audit --omit=dev --audit-level=high",
    "ship": "npm run check && vercel deploy --prod"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@neondatabase/serverless": "^1.2.0",
    "@resvg/resvg-js": "^2.6.2",
    "express": "^4.22.3",
    "iron-session": "^9.0.1",
    "satori": "^0.18.3"
  },
  "devDependencies": {
    "selfsigned": "^5.5.0"
  }
}
