{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "redirects": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "telly-self.vercel.app" }], "destination": "https://usetelly.xyz/$1", "permanent": true },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "www.usetelly.xyz" }], "destination": "https://usetelly.xyz/$1", "permanent": true }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": { "api/index.js": { "includeFiles": "lib/fonts/**" } },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" }
      ]
    }
  ]
}
