# Copy this file to .env and fill it in. Never commit .env.

# From Buffer: Settings -> API -> App Clients -> New Client (https://publish.buffer.com/settings/api)
BUFFER_CLIENT_ID=
# Leave empty if you registered a public client (PKCE only).
BUFFER_CLIENT_SECRET=

# Must match a redirect URI registered on the app client, character for character.
# Buffer requires HTTPS even on localhost; `npm run certs` makes a self-signed certificate.
REDIRECT_URI=https://localhost:3000/callback

PORT=3000

# Required in production (32+ random characters). Locally one is generated into .session-key.
SESSION_SECRET=

# Optional: lets Telly read details off a flyer image. Leave blank to type them in.
ANTHROPIC_API_KEY=
